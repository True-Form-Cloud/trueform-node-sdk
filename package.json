{
  "name": "trueform-node",
  "version": "0.1.0",
  "description": "Official Node.js SDK for the Trueform email validation API",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "author": "Trueform",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:package": "node scripts/check-package.mjs",
    "lint:package": "publint && attw --pack .",
    "check:runtime": "npm run typecheck && npm test && npm run build && npm run test:package",
    "check": "npm run check:runtime && npm run lint:package",
    "prepublishOnly": "npm run check:runtime"
  },
  "keywords": [
    "email",
    "email-validation",
    "nodejs",
    "typescript",
    "trueform"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/True-Form-Cloud/trueform-node-sdk.git"
  },
  "homepage": "https://trueform.cloud/docs/node/",
  "bugs": {
    "url": "https://github.com/True-Form-Cloud/trueform-node-sdk/issues"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@types/node": "^26.2.0",
    "publint": "^0.3.16",
    "tsup": "^8.5.0",
    "typescript": "^7.0.2",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}